APP_NAME=Erronk2D
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8082
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=single
LOG_LEVEL=debug
DB_CONNECTION=sqlite
DB_DATABASE=/app/database/development.sqlite
SESSION_DRIVER=database
SESSION_COOKIE=erronk2d_session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_FROM_ADDRESS=erronk2d@example.test
MAIL_FROM_NAME=Erronk2D
ERRONK2D_DEMO_PASSWORD=
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://erronk2d.jonvadillo.com/auth/google/callback
