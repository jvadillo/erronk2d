APP_NAME=Erronk2D
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://erronk2d.jonvadillo.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
ERRONK2D_RELEASE=local
ERRONK2D_PORT=8082
ERRONK2D_DB_PASSWORD=
LOG_CHANNEL=stderr
LOG_LEVEL=warning
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_COOKIE=erronk2d_session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=no-reply@erronk2d.jonvadillo.com
MAIL_FROM_NAME=Erronk2D
