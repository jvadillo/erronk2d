#!/usr/bin/env bash
set -euo pipefail
umask 077
cd -- "$(dirname -- "$0")/.."
release="${1:?Indica una etiqueta de imágenes ya construidas y verificadas}"
backup_destination="${2:?Indica un directorio NUEVO para la copia previa}"
[[ "$release" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$ ]] || { echo 'Etiqueta no válida.' >&2; exit 1; }
[[ ! -e "$backup_destination" ]] || { echo 'La copia requiere un directorio nuevo.' >&2; exit 1; }
docker image inspect "erronk2d-app:$release" "erronk2d-web:$release" >/dev/null
export ERRONK2D_RELEASE="$release"
compose=(docker compose --env-file .env.production -f compose.production.yml)
"${compose[@]}" config --quiet
reopen() {
    "${compose[@]}" exec -T app php artisan up --no-interaction
}
"${compose[@]}" exec -T app test ! -f /app/storage/framework/down || { echo 'Erronk2D ya está en mantenimiento; conserva ese estado y revisa la operación pendiente.' >&2; exit 1; }
trap reopen EXIT
"${compose[@]}" exec -T app php artisan down --retry=60 --no-interaction
bash ops/backup "$backup_destination"
"${compose[@]}" run --rm -T app php artisan migrate --force --no-interaction
"${compose[@]}" run --rm -T app php artisan erronk2d:demo --no-interaction
"${compose[@]}" up -d --no-deps --wait --wait-timeout 120 app web
python3 - "$release" <<'PY'
from pathlib import Path
import sys
path = Path('.env.production')
lines = path.read_text().splitlines()
lines = [line for line in lines if not line.startswith('ERRONK2D_RELEASE=')]
lines.append('ERRONK2D_RELEASE=' + sys.argv[1])
path.write_text('\n'.join(lines) + '\n')
path.chmod(0o600)
PY
printf '%s\n' 'Versión aplicada y datos ficticios preparados. Verifica HTTPS antes de dar la entrega por terminada.'
