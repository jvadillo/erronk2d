FROM node:22-alpine AS frontend
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY resources ./resources
COPY vite.config.ts tsconfig.json ./
RUN npm run build

FROM erronk2d-php:local AS application
USER root
COPY --chown=root:root . /app
RUN composer install --no-dev --prefer-dist --no-interaction --no-progress --no-scripts --optimize-autoloader \
    && mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chown -R 1000:1000 storage bootstrap/cache
COPY --from=frontend --chown=root:root /app/public/build /app/public/build
COPY ops/php-production.ini /usr/local/etc/php/conf.d/zz-erronk2d.ini
COPY ops/php-pool.conf /usr/local/etc/php-fpm.d/zz-erronk2d.conf
USER 1000:1000
RUN php artisan package:discover --ansi
CMD ["php-fpm", "-F"]

FROM nginx:1.28-alpine AS web
COPY ops/nginx.conf /etc/nginx/nginx.conf
COPY --from=application /app/public /app/public
USER 1000:1000
EXPOSE 8080
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
